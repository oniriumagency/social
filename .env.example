# Variables de entorno del desarrollo local (docs/11 §7).
# Copia este archivo a `.env` y cambia las contraseñas. `.env` nunca se sube (I-10).
# Estos valores solo sirven para la infraestructura local de `pnpm dev:infra`.

# PostgreSQL local
POSTGRES_USER=social
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=social
POSTGRES_PORT=5432

# Almacenamiento compatible con S3 local (SeaweedFS)
S3_ACCESS_KEY_ID=social-dev
S3_SECRET_ACCESS_KEY=cambia-este-secreto
S3_BUCKET=social-media
S3_PORT=8333
